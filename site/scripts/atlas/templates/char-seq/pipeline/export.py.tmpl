"""{%slug%}: export the character LSTM to site/static/models/{%slug%}/ (kind A, design §4.11). Scaffolded on {%today%}.

    npm run atlas -- export {%slug%}

The input is a sequence of character ids of symbolic length T (1..64): the cases include T = 1 and T = 64, so
parity covers both extremes. b.lstm records the gate sub-steps (i f g o c h) and proves them against nn.LSTM (AK104).
The alphabet goes into spec.json as `alphabet` (the text-char adapter maps characters to ids with it).
Without model_final.pt / alphabet.json (run train.py) it exports an untrained model on a tiny alphabet.
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

try:
    import atlas_kit as ak
except ImportError:  # run without PYTHONPATH: use the repo's pipeline/ folder
    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    import atlas_kit as ak

import torch

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from model import CharLSTM  # noqa: E402

T_MAX = 64
afile = HERE / "alphabet.json"
ALPHABET = json.loads(afile.read_text(encoding="utf-8")) if afile.is_file() else ["?", " ", ".", "a", "e", "h", "o", "t"]
INDEX = {c: i for i, c in enumerate(ALPHABET)}
model = CharLSTM(len(ALPHABET))
if (HERE / "model_final.pt").is_file():
    model.load_state_dict(torch.load(HERE / "model_final.pt", map_location="cpu"))
else:
    torch.manual_seed(0)
    model = CharLSTM(len(ALPHABET))
    print("note: model_final.pt not found (run train.py): exporting untrained weights")
model = model.cpu().eval()


def encode(text: str) -> torch.Tensor:
    return torch.tensor([INDEX.get(c, 0) for c in text[-T_MAX:]], dtype=torch.int64)


def describe(b: ak.SpecBuilder, case: ak.Case) -> None:
    ids = b.input("input", case.input, adapter="text-char", kind="text", axes="t", shape=["T"],
                  dims={"T": (1, T_MAX, ("characters", "字符"))}, label=("Your text", "你的文字"))
    e = b.embedding("emb", ids, model.emb, label=("Character vectors", "字符向量"))
    h = b.lstm("lstm", e, model.lstm, label=("LSTM memory", "LSTM 记忆"))
    z = b.linear("head", h, model.head, label=("Next-character scores", "下一个字符的分数"))
    b.output(b.softmax("probs", z, label=("Next-character chances", "下一个字符的概率")))


class WithSoftmax(torch.nn.Module):
    def __init__(self, m):
        super().__init__()
        self.m = m

    def forward(self, ids):
        return torch.softmax(self.m(ids), dim=-1)


TEXTS = ["Once upon a time, there was a little dog.", "The sun was hot. Tom went to the park to play with his ball and his friend Sue, and they laughed."]
CASES = [ak.Case("one", "one character", encode("O"), edge=True)]
CASES += [ak.Case(f"text{i}", t[:24], encode(t)) for i, t in enumerate(TEXTS)]
CASES += [ak.Case("max", f"{T_MAX} characters", encode((TEXTS[1] * 2)[:T_MAX]), edge=True)]

if __name__ == "__main__":
    report = ak.export_model(describe, CASES, slug="{%slug%}", name=("{%nameEn%}", "{%nameZh%}"), kinds=({%kindsPy%}),
                             module=WithSoftmax(model), module_input=lambda c: c.input,
                             extras={"alphabet": ALPHABET, "unk": "?", "context": T_MAX})
    print(report)
