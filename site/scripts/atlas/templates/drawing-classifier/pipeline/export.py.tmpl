"""{%slug%}: export the trained CNN to site/static/models/{%slug%}/ (kind A, design §4.11). Scaffolded on {%today%}.

    npm run atlas -- export {%slug%}          # runs this file, then parity --write and the lesson draft

describe() names every step of Net.forward with a builder call; export_model() checks it against the module (AK103),
writes spec.json, weights.bin, reference.json (the cases below, with blank and dot edge cases) and presets.json in
TinyCNN's format (base64 uint8 28x28 bitmaps). Without model_final.pt it exports untrained weights (smoke test only);
without the Quick, Draw! files it uses synthetic drawings for the cases.
"""
from __future__ import annotations

import base64
import json
import sys
from pathlib import Path

try:
    import atlas_kit as ak
except ImportError:  # run without PYTHONPATH: use the repo's pipeline/ folder
    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    import atlas_kit as ak

import numpy as np
import torch

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from model import CLASSES, Net  # noqa: E402

ZH = {"apple": "苹果", "house": "房子", "sun": "太阳"}  # TODO: Chinese names for your classes
CKPT = HERE / "model_final.pt"

model = Net()
if CKPT.is_file():
    model.load_state_dict(torch.load(CKPT, map_location="cpu"))
else:
    print(f"note: {CKPT.name} not found (run train.py): exporting untrained weights, fine for a smoke test only")
model = model.cpu().eval()


def describe(b: ak.SpecBuilder, case: ak.Case) -> None:
    x = b.input("input", case.input, adapter="drawing28", kind="drawing", axes="c,y,x",
                label=("Your drawing", "你的画"), desc=("28x28 numbers: 0 is empty, 1 is full ink.", "28x28 个数：0 是空白，1 是满墨。"))
    h = b.conv2d("conv1", x, model.conv1, label=("Conv 1", "卷积 1"))
    h = b.relu("relu1", h, label=("ReLU 1", "ReLU 1"))
    h = b.maxpool2d("pool1", h, 2, label=("Max pool 1", "最大池化 1"))
    h = b.conv2d("conv2", h, model.conv2, label=("Conv 2", "卷积 2"))
    h = b.relu("relu2", h, label=("ReLU 2", "ReLU 2"))
    h = b.maxpool2d("pool2", h, 2, label=("Max pool 2", "最大池化 2"))
    h = b.flatten("flatten", h, label=("Flatten", "展平"))
    h = b.linear("fc", h, model.fc, label=("Class scores", "类别分数"))
    b.output(b.softmax("softmax", h, label=("Probabilities", "概率")))


class WithSoftmax(torch.nn.Module):
    def __init__(self, m):
        super().__init__()
        self.m = m

    def forward(self, x):
        return torch.softmax(self.m(x), dim=-1)


def drawings() -> tuple[list, dict]:
    """Reference drawings (2 test drawings per class) and presets (6 per class), or synthetic strokes without data."""
    try:
        X, y, _ = ak.data.quickdraw(CLASSES, "test")
    except ak.AtlasError as e:
        print(f"note: no Quick, Draw! data ({e.code}); using synthetic drawings")
        line = np.zeros((28, 28), np.uint8)
        line[14, 4:24] = 255
        box = np.zeros((28, 28), np.uint8)
        box[6:22, 6] = box[6:22, 21] = box[6, 6:22] = box[21, 6:22] = 255
        X, y = np.stack([line, box, line.T]), np.array([0, 1, 2 % len(CLASSES)])
    cases, presets = [], {"note": "Quick, Draw! test drawings (CC BY 4.0, Google Creative Lab); b64 = 784 uint8, white on black", "classes": []}
    for k, name in enumerate(CLASSES):
        idx = np.where(y == k)[0]
        for j in idx[:2]:
            cases.append(ak.Case(f"{name}-{int(j)}", name, torch.tensor(X[j], dtype=torch.float32).reshape(1, 28, 28) / 255))
        presets["classes"].append({"id": name, "en": name, "zh": ZH.get(name, name),
                                   "items": [{"b64": base64.b64encode(np.ascontiguousarray(X[j]).tobytes()).decode()} for j in idx[:6]]})
    dot = torch.zeros(1, 28, 28)
    dot[0, 14, 14] = 1.0
    cases += [ak.Case("blank", "blank", torch.zeros(1, 28, 28), edge=True), ak.Case("dot", "one dot", dot, edge=True)]
    return cases, presets


if __name__ == "__main__":
    mfile = HERE / "train_metrics.json"
    tm = json.loads(mfile.read_text(encoding="utf-8")) if mfile.is_file() else {}
    cases, presets = drawings()
    report = ak.export_model(
        describe, cases, slug="{%slug%}", name=("{%nameEn%}", "{%nameZh%}"), kinds=({%kindsPy%}),
        module=WithSoftmax(model), module_input=lambda c: c.input.unsqueeze(0),
        extras={"classes": [{"id": c, "en": c, "zh": ZH.get(c, c)} for c in CLASSES]},
        facts={"testAcc": {"value": tm["test_acc"], "unit": "share", "source": "pipeline/{%slug%}/train.py"}} if "test_acc" in tm else None,
        presets=presets,
        training={"dataset": "Quick, Draw! (TinyCNN split)", "steps": 0, "metrics": {k: tm[k] for k in ("test_acc", "test_n") if k in tm}},
    )
    print(report)
