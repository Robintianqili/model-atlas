<script lang="ts">
	import type { StageProps } from '{%typesPath%}';

	let { props, provenance }: StageProps = $props();
	const values = $derived((props.values as number[] | undefined) ?? []);
	const max = $derived(values.length ? Math.max(...values.map(Math.abs)) : 1);
</script>

<figure class="view">
	<ul class="bars">
		{#each values as v, i (i)}
			<li>
				<span class="bar" style:width="{(100 * Math.abs(v)) / (max || 1)}%"></span>
				<span class="num">{v.toPrecision(3)}</span>
			</li>
		{/each}
	</ul>
	<figcaption>TODO: what the learner should look at ({provenance})</figcaption>
</figure>

